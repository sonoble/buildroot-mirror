Fix namespace keyword conflict with gawk 4.0+

Newer versions of gawk (4.0+) made 'namespace' a reserved keyword.
Rename the variable to 'nm' to avoid the conflict.

This fixes the error:
gawk: fatal: cannot use gawk builtin `namespace' as variable name

Signed-off-by: Claude Code <noreply@anthropic.com>

--- a/src/Makefile.am
+++ b/src/Makefile.am
@@ -51,7 +51,7 @@ code-from-errno.h: mkerrcodes$(EXEEXT_FOR_BUILD) Makefile

 errnos-sym.h: Makefile mkstrtable.awk errnos.in
 	$(AWK) -f $(srcdir)/mkstrtable.awk -v textidx=2 -v nogettext=1 \
-		-v prefix=GPG_ERR_ -v namespace=errnos_ \
+		-v prefix=GPG_ERR_ -v nm=errnos_ \
 		$(srcdir)/errnos.in >$@


--- a/src/Makefile.in
+++ b/src/Makefile.in
@@ -894,7 +894,7 @@ code-from-errno.h: mkerrcodes$(EXEEXT_FOR_BUILD) Makefile

 errnos-sym.h: Makefile mkstrtable.awk errnos.in
 	$(AWK) -f $(srcdir)/mkstrtable.awk -v textidx=2 -v nogettext=1 \
-		-v prefix=GPG_ERR_ -v namespace=errnos_ \
+		-v prefix=GPG_ERR_ -v nm=errnos_ \
 		$(srcdir)/errnos.in >$@

